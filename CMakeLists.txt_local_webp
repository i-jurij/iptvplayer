cmake_minimum_required(VERSION 3.31)
project(iptvplayer VERSION 1.0.0 LANGUAGES CXX)

set(CMAKE_BUILD_TYPE Debug)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

# =========================
# Для генерации .deb, .rpm, .exe, .dmg
# =========================
include(CPack)

# =========================
# Жёстко указываем локальную установку wxWidgets
# =========================
set(LOCAL_WX_INSTALL "${CMAKE_SOURCE_DIR}/third_party/wx/install" CACHE PATH "Local wxWidgets install dir")

# Помещаем локальную установку в начало CMAKE_PREFIX_PATH, чтобы приоритет был у неё
if(NOT CMAKE_PREFIX_PATH)
  set(CMAKE_PREFIX_PATH "${LOCAL_WX_INSTALL}" CACHE PATH "CMake prefix path" FORCE)
else()
  list(INSERT CMAKE_PREFIX_PATH 0 "${LOCAL_WX_INSTALL}")
  set(CMAKE_PREFIX_PATH "${CMAKE_PREFIX_PATH}" CACHE PATH "CMake prefix path" FORCE)
endif()

# Ищем в CONFIG-режиме и запрещаем системные пути
# Версию можно опустить; если хотите требовать минимум 3.3.2 — замените на "3.3.2"
find_package(wxWidgets CONFIG REQUIRED COMPONENTS core base aui xrc xml net adv
  HINTS "${LOCAL_WX_INSTALL}"
  PATHS "${LOCAL_WX_INSTALL}"
  NO_DEFAULT_PATH
  NO_CMAKE_SYSTEM_PATH
  NO_CMAKE_PATH
  NO_SYSTEM_ENVIRONMENT_PATH
  NO_CMAKE_INSTALL_PREFIX
)

# Диагностика и жёсткая проверка локальности
if(NOT wxWidgets_FOUND)
  message(FATAL_ERROR "wxWidgets not found in local install: ${LOCAL_WX_INSTALL}")
endif()

message(STATUS "wxWidgets found: version=${wxWidgets_VERSION} dir=${wxWidgets_DIR}")

# Убедиться, что найденный wxWidgets действительно из локальной установки
if(DEFINED wxWidgets_DIR)
  file(TO_CMAKE_PATH "${wxWidgets_DIR}" _wx_dir_norm)
  file(TO_CMAKE_PATH "${LOCAL_WX_INSTALL}" _local_norm)
  string(FIND "${_wx_dir_norm}" "${_local_norm}" _pos)
  if(_pos EQUAL -1)
    message(FATAL_ERROR "Detected wxWidgets outside project: ${wxWidgets_DIR}. Configure to use local ${LOCAL_WX_INSTALL} only.")
  endif()
endif()

# Создаём агрегатный интерфейсный таргет wx_all автоматически,
# добавляя только те импортированные таргеты, которые доступны.
set(_wx_components core base aui xrc xml net adv)
add_library(wx_all INTERFACE)
foreach(_comp IN LISTS _wx_components)
  set(_target "wx::${_comp}")
  if(TARGET ${_target})
    target_link_libraries(wx_all INTERFACE ${_target})
    message(STATUS "Added ${_target} to wx_all")
  else()
    message(STATUS "wx target ${_target} not available, skipping")
  endif()
endforeach()

# =========================
# CURL
# =========================
find_package(CURL REQUIRED)
if(TARGET CURL::libcurl)
  set(_CURL_TARGET CURL::libcurl)
else()
  # fallback на переменные, если модульный пакет не предоставляет таргет
  set(_CURL_TARGET "")
  message(STATUS "CURL target not available; will use variables if present")
endif()

# =========================
# Local libwebp (encode-only)
# =========================
set(WEBP_LOCAL ${CMAKE_SOURCE_DIR}/third_party/libwebp/install)

# libwebp.a
find_library(WEBP_STATIC_LIB
    NAMES webp
    PATHS ${WEBP_LOCAL}/lib
    NO_DEFAULT_PATH
)

# libsharpyuv.a
find_library(SHARPYUV_LIB
    NAMES sharpyuv
    PATHS ${WEBP_LOCAL}/lib
    NO_DEFAULT_PATH
)

# include/
find_path(WEBP_INCLUDE_DIR
    NAMES webp/encode.h
    PATHS ${WEBP_LOCAL}/include
    NO_DEFAULT_PATH
)

if (NOT WEBP_STATIC_LIB)
    message(FATAL_ERROR "Local libwebp.a not found in ${WEBP_LOCAL}/lib")
endif()

if (NOT SHARPYUV_LIB)
    message(FATAL_ERROR "Local libsharpyuv.a not found in ${WEBP_LOCAL}/lib")
endif()

if (NOT WEBP_INCLUDE_DIR)
    message(FATAL_ERROR "Local libwebp headers not found in ${WEBP_LOCAL}/include")
endif()

message(STATUS "Using local libwebp: ${WEBP_STATIC_LIB}")
message(STATUS "Using local libsharpyuv: ${SHARPYUV_LIB}")

set(WEBP_LIBRARIES
    ${WEBP_STATIC_LIB}
    ${SHARPYUV_LIB}
)

